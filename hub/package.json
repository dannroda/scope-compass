{
  "name": "scope-compass",
  "version": "0.1.0",
  "private": true,
  "description": "Hub y CLI de Scope Compass: tablero de tareas por hito con los datos en git.",
  "type": "module",
  "bin": {
    "scompass": "bin/scompass.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "assets",
    "web",
    "schema",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node -e \"try{require('node:fs').writeFileSync('node_modules/.gdignore','')}catch{}\"",
    "test": "SCOMPASS_REGISTRY=\"${TMPDIR:-/tmp}/scompass-test-registry-$$\" node --test"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/websocket": "^11.3.1",
    "@homebridge/dbus-native": "^0.7.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.5",
    "markdown-it": "^15.0.2",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
